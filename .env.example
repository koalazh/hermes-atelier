# Hermes Atelier never reads this file automatically. Copy values into the
# ignored .hermes-runtime/profiles/<profile>/.env files via scripts/bootstrap.py.

# OpenAI-compatible model configuration used by generated Hermes Profiles.
OPENAI_API_KEY=
ATELIER_MODEL_BASE_URL=https://api.example.com/v1
ATELIER_MODEL=example-model

# Optional command override when `hermes` is not on PATH.
HERMES_BIN=hermes
